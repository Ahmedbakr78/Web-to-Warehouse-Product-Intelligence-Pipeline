# =====================================================================
#  Web-to-Warehouse Product Intelligence Pipeline - Environment Template
#  Copy to `.env` and adjust:  cp .env.example .env
# =====================================================================

# ---------- Application ----------
APP_NAME="Product Intelligence Pipeline"
APP_ENV=development              # development | testing | production
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_TIMEZONE=UTC
APP_LOG_LEVEL=INFO
APP_LOG_FORMAT=text              # text | json

# ---------- Database (PostgreSQL - primary analytical warehouse) ----------
# Local Docker:  postgresql+psycopg2://pip:pip@localhost:5432/pipeline
DATABASE_URL=postgresql+psycopg2://pip:pip@localhost:5432/pipeline
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800

# ---------- Database (MySQL - required secondary target) ----------
MYSQL_URL=mysql+pymysql://pip:pip@localhost:3306/pipeline?charset=utf8mb4
# Active target: postgres | mysql  (CLI --database flag overrides this)
ACTIVE_DATABASE=postgres
# Schema used for cross-dialect-safe table creation
DB_SCHEMA=public

# ---------- Security / Auth ----------
SECRET_KEY=change-me-to-a-long-random-string-please-32-chars-min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
REFRESH_TOKEN_EXPIRE_DAYS=30
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# Seeded on first boot (documented demo credentials)
SEED_ADMIN_EMAIL=admin@pipeline.local
SEED_ADMIN_PASSWORD=Admin@12345
SEED_ANALYST_EMAIL=analyst@pipeline.local
SEED_ANALYST_PASSWORD=Analyst@12345
SEED_VIEWER_EMAIL=viewer@pipeline.local
SEED_VIEWER_PASSWORD=Viewer@12345
SEED_DEMO_DATA=true

# ---------- Ingestion / Compliance ----------
INGEST_USER_AGENT="ProductIntelligenceBot/1.0 (+https://example.local/bot; contact: data-team@example.local)"
RESPECT_ROBOTS_TXT=true
REQUEST_TIMEOUT_SECONDS=20
MAX_RETRIES=3
RETRY_BACKOFF_SECONDS=1.5
REQUESTS_PER_SECOND=1.0
REQUESTS_PER_MINUTE=30
CRAWL_DELAY_FALLBACK_SECONDS=2.0
MAX_CONCURRENT_REQUESTS=4
CACHE_ENABLED=true
CACHE_TTL_SECONDS=1800
RESPECT_TERMS_WHITELIST=true          # only sources explicitly allowlisted

# ---------- Pipeline ----------
PIPELINE_BATCH_SIZE=500
PIPELINE_FAIL_FAST=false
DEDUPE_SIMILARITY_THRESHOLD=0.90       # 0..1 fuzzy match threshold
DEDUPE_BLOCKING_KEY_LENGTH=4

# ---------- Frontend ----------
VITE_API_BASE_URL=http://localhost:8000/api/v1
FRONTEND_PORT=5173