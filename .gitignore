# ---------- Python ----------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.Python
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
coverage.xml
.tox/

# ---------- Databases / local data ----------
*.sqlite3
*.db
data/
var/
logs/
*.log
!docs/**/*.log
mysql_data/
pg_data/
.airflow/

# ---------- Node / Frontend ----------
node_modules/
frontend/dist/
frontend/.vite/
frontend/.vite-inspect/
*.tsbuildinfo
npm-debug.log*
yarn-error.log*

# ---------- Secrets / env ----------
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# ---------- Tooling ----------
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json
.DS_Store
Thumbs.db
*.swp

# ---------- Alembic ----------
# The revisions themselves are committed; nothing generated inside them is not.
migrations/**/__pycache__/

# ---------- Generated site assets ----------
# The built pages under site/ are committed: the site is a deliverable. The rendered
# SVGs inside it are generated by `make docs-render`, so only the gallery page is
# tracked, not the 67 files it links to.
site/diagrams/*.svg
# ---------- Generated diagrams ----------
# The .mmd sources are committed (they are the source of truth and reviewable in a
# diff). The rendered SVGs are 5 MB of derived output that goes stale on any edit, so
# they are regenerated by `make docs-render` and by the docs CI job instead.
docs/diagrams/out/*.svg
docs/diagrams/out/*.png
